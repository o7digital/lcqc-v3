## DatoCMS
# Required: API token for GraphQL Content Delivery API (published content)
DATOCMS_API_TOKEN=your_datocms_cda_token_here

# Optional: Preview mode (to include drafts)
# - Set to 'true' in dev/approve only
DATOCMS_USE_PREVIEW=false
# Preview API token (recommended for preview mode). If not set, falls back to DATOCMS_API_TOKEN.
DATOCMS_PREVIEW_TOKEN=your_datocms_preview_token_here

# Optional: DatoCMS environment name
# Examples: main (default), dev, approve
DATOCMS_ENVIRONMENT=dev
