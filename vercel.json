{
  "redirects": [
    {
      "source": "/:path((?!gestion-ofertas(?:/|$)|api/offers(?:/|$)|api/offers-reminder(?:/|$)|_astro/|images/logo/|offers/).*)",
      "has": [
        {
          "type": "host",
          "value": "lcqc-offers.o7digitalgroup.com"
        }
      ],
      "destination": "/gestion-ofertas/",
      "permanent": false
    },
    {
      "source": "/aprove/:path*",
      "destination": "/approve/:path*",
      "permanent": false
    },
    {
      "source": "/es/aprove/:path*",
      "destination": "/es/approve/:path*",
      "permanent": false
    },
    {
      "source": "/savings",
      "destination": "https://lcqc.tempurl.host/savings/",
      "permanent": false
    },
    {
      "source": "/savings/",
      "destination": "https://lcqc.tempurl.host/savings/",
      "permanent": false
    },
    {
      "source": "/es/ahorros",
      "destination": "https://lcqc.tempurl.host/es/ahorros/",
      "permanent": false
    },
    {
      "source": "/es/ahorros/",
      "destination": "https://lcqc.tempurl.host/es/ahorros/",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/offers-reminder",
      "schedule": "0 15 * * *"
    }
  ]
}
