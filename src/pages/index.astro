---
import Layout from '@layouts/Layout.astro';
import BookingEngine from '@components/BookingEngine.astro';
import { fetchDatoCMS } from '@lib/datocms';
import sliderBackup from '../data/slider-backup.json';

const query = `
{
  allSliders {
    id
    media {
      url
    }
    description
    sortOrder
  }
}
`;
const buildLocalSources = (base) => ({
  webp: `/images/slider/${base}-640.webp 640w, /images/slider/${base}-1280.webp 1280w, /images/slider/${base}-1920.webp 1920w`,
  jpg: `/images/slider/${base}-640.jpg 640w, /images/slider/${base}-1280.jpg 1280w, /images/slider/${base}-1920.jpg 1920w`,
  fallback: `/images/slider/${base}-1920.jpg`,
});
const localHeroSlide = {
  id: 'local-casa-sunset',
  baseName: 'casa-sunset',
  description: 'Sunset suites with Pacific views',
  localSources: buildLocalSources('casa-sunset'),
};
const replacementSlide7 = {
  id: 'local-replace-slide-7',
  baseName: 'dato-slide-07',
  description: 'Lobby with ocean view',
  localSources: buildLocalSources('custom-slide-07'),
};

const buildLocalSlideFromBackup = (slide, overrides = {}) => ({
  id: `local-${slide.baseName}`,
  baseName: slide.baseName,
  description: slide.description,
  focalPoint: slide.focalPoint || null,
  localSources: buildLocalSources(slide.baseName),
  ...overrides,
});

const localDatoSlides = sliderBackup.map((slide) => buildLocalSlideFromBackup(slide));
const sliderBackupById = new Map(sliderBackup.map((slide) => [slide.id, slide]));
const sliderBackupByUrl = new Map(sliderBackup.map((slide) => [slide.url, slide]));

const clamp01 = (value) => Math.max(0, Math.min(1, value));
const objPos = (fp) => {
  if (!fp || typeof fp.x !== 'number' || typeof fp.y !== 'number') return '50% 50%';
  const x = clamp01(fp.x);
  const y = clamp01(fp.y);
  return `${Math.round(x * 100)}% ${Math.round(y * 100)}%`;
};
const imgStyle = (fp) => (fp ? `object-position: ${objPos(fp)};` : undefined);

let datoOrderBaseNames = [];
const datoOverridesByBaseName = new Map();
try {
  const data = await fetchDatoCMS(query);
  const datoSlides = (data?.allSliders || []).sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0));
  datoOrderBaseNames = datoSlides
    .map((slide) => sliderBackupById.get(slide.id) || sliderBackupByUrl.get(slide.media?.url))
    .filter(Boolean)
    .map((slide) => slide.baseName);
  datoSlides.forEach((slide) => {
    const backup = sliderBackupById.get(slide.id) || sliderBackupByUrl.get(slide.media?.url);
    if (!backup) return;
    datoOverridesByBaseName.set(backup.baseName, {
      description: slide.description || backup.description,
    });
  });
} catch (error) {
  console.error('DatoCMS slider fetch failed, using local backup.', error);
}

const baseSlides = datoOrderBaseNames.length > 0
  ? [
      ...datoOrderBaseNames
        .map((baseName) => localDatoSlides.find((slide) => slide.baseName === baseName))
        .filter(Boolean)
        .map((slide) => {
          const overrides = datoOverridesByBaseName.get(slide.baseName);
          return overrides ? { ...slide, ...overrides } : slide;
        }),
      ...localDatoSlides
        .filter((slide) => !datoOrderBaseNames.includes(slide.baseName))
        .map((slide) => {
          const overrides = datoOverridesByBaseName.get(slide.baseName);
          return overrides ? { ...slide, ...overrides } : slide;
        }),
    ]
  : localDatoSlides;
const adjustedSlides = baseSlides
  .filter((slide) => slide.baseName !== 'dato-slide-01')
  .map((slide) => (slide.baseName === 'dato-slide-07' ? replacementSlide7 : slide));
const heroSlides = [localHeroSlide, ...adjustedSlides];
// Temporarily hide the booking engine (bug investigation)
const hideBooking = true;
---

<Layout
  title="La Casa Que Canta"
  description="La Casa Que Canta is an exclusive romantic beach boutique hotel in Ixtapa Zihuatanejo, Mexico, with luxury suites, oceanfront pools and tailored experiences."
>
  <section class="scroll-section grid relative">
    <!-- Slider Desktop -->
    <div class="hidden md:block absolute top-0 left-0 w-full h-full overflow-hidden">
      <div class="swiper mySwiper w-full h-full">
        <div class="swiper-wrapper">
          {heroSlides.length > 0 ? heroSlides.map((slide, i) => (
            <div class="swiper-slide">
              {slide.localSources ? (
                <picture>
                  <source
                    type="image/webp"
                    srcset={`${slide.localSources.webp}`}
                    sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                  />
                  <img
                    src={slide.localSources.fallback}
                    srcset={`${slide.localSources.jpg}`}
                    sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                    class="w-full h-full object-cover"
                    style={imgStyle(slide.focalPoint)}
                    alt={slide.description || 'Slide'}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </picture>
              ) : (
                <picture>
                  <source
                    type="image/avif"
                    srcset={`${slide.media.url}?fm=avif&q=60&w=640 640w, ${slide.media.url}?fm=avif&q=60&w=1280 1280w, ${slide.media.url}?fm=avif&q=60&w=1920 1920w`}
                    sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                  />
                  <source
                    type="image/webp"
                    srcset={`${slide.media.url}?fm=webp&q=60&w=640 640w, ${slide.media.url}?fm=webp&q=60&w=1280 1280w, ${slide.media.url}?fm=webp&q=60&w=1920 1920w`}
                    sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                  />
                  <img
                    src={`${slide.media.url}?auto=compress&q=70&w=1280`}
                    srcset={`${slide.media.url}?auto=compress&q=70&w=640 640w, ${slide.media.url}?auto=compress&q=70&w=1280 1280w, ${slide.media.url}?auto=compress&q=70&w=1920 1920w`}
                    sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                    class="w-full h-full object-cover"
                    alt={slide.description || 'Slide'}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </picture>
              )}
            </div>
          )) : (
            <div class="swiper-slide bg-black text-white flex items-center justify-center">
              Sin imágenes en el slider
            </div>
          )}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>

    <!-- Slider Mobile -->
    <div class="md:!hidden swiper mySwiper !absolute h-full w-full top-0 overflow-hidden aspect-[16/6]">
      <div class="swiper-wrapper">
        {heroSlides.length > 0 ? heroSlides.map((slide, i) => (
          <div class="swiper-slide">
            {slide.localSources ? (
              <picture>
                <source
                  type="image/webp"
                  srcset={`${slide.localSources.webp}`}
                  sizes="(max-width: 480px) 320px, (max-width: 768px) 640px, 1024px"
                />
                <img
                  src={slide.localSources.fallback}
                  srcset={`${slide.localSources.jpg}`}
                  sizes="(max-width: 480px) 320px, (max-width: 768px) 640px, 1024px"
                  class="w-full h-full object-cover"
                  style={imgStyle(slide.focalPoint)}
                  alt={slide.description || 'Slide'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            ) : (
              <picture>
                <source
                  type="image/avif"
                  srcset={`${slide.media.url}?fm=avif&q=60&w=320 320w, ${slide.media.url}?fm=avif&q=60&w=640 640w, ${slide.media.url}?fm=avif&q=60&w=1024 1024w`}
                  sizes="(max-width: 480px) 320px, (max-width: 768px) 640px, 1024px"
                />
                <source
                  type="image/webp"
                  srcset={`${slide.media.url}?fm=webp&q=60&w=320 320w, ${slide.media.url}?fm=webp&q=60&w=640 640w, ${slide.media.url}?fm=webp&q=60&w=1024 1024w`}
                  sizes="(max-width: 480px) 320px, (max-width: 768px) 640px, 1024px"
                />
                <img
                  src={`${slide.media.url}?auto=compress&q=70&w=640`}
                  srcset={`${slide.media.url}?auto=compress&q=70&w=320 320w, ${slide.media.url}?auto=compress&q=70&w=640 640w, ${slide.media.url}?auto=compress&q=70&w=1024 1024w`}
                  sizes="(max-width: 480px) 320px, (max-width: 768px) 640px, 1024px"
                  class="w-full h-full object-cover"
                  alt={slide.description || 'Slide'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            )}
          </div>
        )) : (
          <div class="swiper-slide bg-black text-white flex items-center justify-center">
            Sin imágenes en el slider
          </div>
        )}
      </div>
      <div class="swiper-pagination"></div>
    </div>

    <!-- Michelin + SLH logos overlay inside hero (bottom-right); aligned horizontally and raised on desktop to avoid chatbot overlap -->
    <div class="absolute bottom-[54px] md:bottom-[120px] right-4 z-20 flex items-center gap-3 md:gap-4">
      <img src="/logo-white.svg" alt="Small Luxury Hotels of the World" class="h-16 md:h-20 w-auto drop-shadow-xl" />
      <img src="/images/1 MICHELIN Key_2025_Round_Red.png" alt="Michelin 2025" class="w-20 md:w-24 h-auto drop-shadow-xl" />
    </div>

    <!-- Contenido -->
    <div class="relative pt-24 md:pt-4 z-10 w-full text-center">
      <div class="mix-blend-difference">
        <h1 class="relative text-4xl md:text-4xl lg:text-5xl xl:text-7xl text-white font-bold">
          La Casa Que Canta
        </h1>
      </div>
    </div>

    <!-- Booking Engine centrado (hidden on dev/preview) -->
    {hideBooking ? null : (
      <div class="absolute bottom-10 w-full z-20 flex justify-center">
        <div class="booking-hover-zone group" tabindex="0" style="outline:none;">
          <div class="bg-black/10 group-hover:bg-black/20 group-focus-within:bg-black/20 backdrop-blur-sm transition rounded-lg p-4 opacity-0 pointer-events-none scale-95 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:scale-100" id="booking-bar-container">
            <BookingEngine/>
          </div>
        </div>
      </div>
    )}
  </section>

  <script>
    import Swiper from "swiper";
    import { Pagination, Autoplay } from "swiper/modules";
    import "swiper/css";
    import "swiper/css/pagination";

    new Swiper(".mySwiper", {
      modules: [Pagination, Autoplay],
      pagination: { el: ".swiper-pagination", clickable: true },
      autoplay: { delay: 5000, disableOnInteraction: false },
      loop: true,
    });
  </script>

  <style is:global>
    .scroll-section { height: 100vh; position: relative; }
    .swiper, .swiper-slide { width: 100%; height: 100%; }
    /* Hide pagination bullets for hero slider (desktop + mobile) */
    .scroll-section .swiper-pagination { display: none !important; }
    .booking-hover-zone .bg-black\/10 {
      transition: opacity 0.3s, transform 0.3s;
    }
  </style>

  <script>
    // Pour le support tactile/mobile : afficher le booking bar au toucher
    if (typeof window !== 'undefined') {
      const box = document.querySelector('.booking-hover-zone');
      const barContainer = document.getElementById('booking-bar-container');
      if (box && barContainer) {
        let hideTimeout;
        box.addEventListener('touchstart', () => {
          barContainer.style.opacity = '1';
          barContainer.style.pointerEvents = 'auto';
          barContainer.style.transform = 'scale(1)';
          clearTimeout(hideTimeout);
          // Masquer après 2s si pas d'interaction
          hideTimeout = setTimeout(() => {
            barContainer.style.opacity = '0';
            barContainer.style.pointerEvents = 'none';
            barContainer.style.transform = 'scale(0.95)';
          }, 2000);
        });
      }
    }
  </script>
</Layout>
