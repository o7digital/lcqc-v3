---
import Layout from '@layouts/Layout.astro';
import BookingEngine from '@components/BookingEngine.astro';

const heroImage = {
  url: '/intro-1.jpg',
  focalPoint: { x: 0.5, y: 0.35 },
  description: 'La Casa Que Canta',
};
const fpParams = (fp) =>
  fp && typeof fp.x === 'number' && typeof fp.y === 'number'
    ? `&fp-x=${fp.x}&fp-y=${fp.y}`
    : '';
// Temporarily hide the booking engine (bug investigation)
const hideBooking = true;
---

<Layout
  title="La Casa Que Canta"
  description="La Casa Que Canta is an exclusive romantic beach boutique hotel in Ixtapa Zihuatanejo, Mexico, with luxury suites, oceanfront pools and tailored experiences."
>
  <section class="scroll-section grid relative">
    <div class="absolute top-20 right-8 z-10">
      <img class="hidden md:block" src="/logo-white.svg" width="115px" alt="La Casa Que Canta - Luxury Boutique Hotel Zihuatanejo">
    </div>

    <!-- Hero Desktop (static) -->
    <div class="hidden md:block absolute top-0 left-0 w-full h-full overflow-hidden">
      <picture>
        <source
          type="image/avif"
          srcset={`${heroImage.url}?fm=avif&q=60&w=640 640w, ${heroImage.url}?fm=avif&q=60&w=1280 1280w, ${heroImage.url}?fm=avif&q=60&w=1920 1920w`}
          sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
        />
        <source
          type="image/webp"
          srcset={`${heroImage.url}?fm=webp&q=60&w=640 640w, ${heroImage.url}?fm=webp&q=60&w=1280 1280w, ${heroImage.url}?fm=webp&q=60&w=1920 1920w`}
          sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
        />
        <img
          src={`${heroImage.url}?auto=compress&q=70&w=1280`}
          srcset={`${heroImage.url}?auto=compress&q=70&w=640 640w, ${heroImage.url}?auto=compress&q=70&w=1280 1280w, ${heroImage.url}?auto=compress&q=70&w=1920 1920w`}
          sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
          class="w-full h-full object-cover"
          style="object-position: center top;"
          alt={heroImage.description}
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>

    <!-- Hero Mobile (static + focal crop) -->
    <div class="md:!hidden absolute h-full w-full top-0 overflow-hidden">
      <picture>
        <source
          type="image/avif"
          srcset={`${heroImage.url}?fm=avif&q=60&fit=crop&crop=focalpoint&ar=4:5&w=320${fpParams(heroImage.focalPoint)} 320w, ${heroImage.url}?fm=avif&q=60&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(heroImage.focalPoint)} 640w, ${heroImage.url}?fm=avif&q=60&fit=crop&crop=focalpoint&ar=4:5&w=1024${fpParams(heroImage.focalPoint)} 1024w`}
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset={`${heroImage.url}?fm=webp&q=60&fit=crop&crop=focalpoint&ar=4:5&w=320${fpParams(heroImage.focalPoint)} 320w, ${heroImage.url}?fm=webp&q=60&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(heroImage.focalPoint)} 640w, ${heroImage.url}?fm=webp&q=60&fit=crop&crop=focalpoint&ar=4:5&w=1024${fpParams(heroImage.focalPoint)} 1024w`}
          sizes="100vw"
        />
        <img
          src={`${heroImage.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(heroImage.focalPoint)}`}
          srcset={`${heroImage.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=320${fpParams(heroImage.focalPoint)} 320w, ${heroImage.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(heroImage.focalPoint)} 640w, ${heroImage.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=1024${fpParams(heroImage.focalPoint)} 1024w`}
          sizes="100vw"
          class="w-full h-full object-cover object-center"
          alt={heroImage.description}
          loading="eager"
          decoding="async"
        />
      </picture>
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/35 via-black/10 to-transparent pointer-events-none"></div>
    </div>

    <!-- Michelin logo overlay inside hero (bottom-right); raise on desktop (~3cm ≈ 120px) to avoid chatbot overlap -->
    <div class="absolute bottom-[54px] md:bottom-[120px] right-4 z-20">
      <img src="/images/1 MICHELIN Key_2025_Round_Red.png" alt="Michelin 2025" class="w-20 md:w-24 h-auto drop-shadow-xl" />
    </div>

    <!-- Contenido -->
    <div class="relative pt-24 md:pt-4 z-10 w-full text-center">
      <div class="mix-blend-difference">
        <h1 class="relative text-4xl md:text-4xl lg:text-5xl xl:text-7xl text-white font-bold">
          La Casa Que Canta
        </h1>
      </div>
    </div>

    <!-- Booking Engine centrado (hidden on dev/preview) -->
    {hideBooking ? null : (
      <div class="absolute bottom-10 w-full z-20 flex justify-center">
        <div class="booking-hover-zone group" tabindex="0" style="outline:none;">
          <div class="bg-black/10 group-hover:bg-black/20 group-focus-within:bg-black/20 backdrop-blur-sm transition rounded-lg p-4 opacity-0 pointer-events-none scale-95 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:scale-100" id="booking-bar-container">
            <BookingEngine/>
          </div>
        </div>
      </div>
    )}
  </section>

  <style is:global>
    .scroll-section { height: 100vh; position: relative; }
    .booking-hover-zone .bg-black\/10 {
      transition: opacity 0.3s, transform 0.3s;
    }
  </style>

  <script>
    // Pour le support tactile/mobile : afficher le booking bar au toucher
    if (typeof window !== 'undefined') {
      const box = document.querySelector('.booking-hover-zone');
      const barContainer = document.getElementById('booking-bar-container');
      if (box && barContainer) {
        let hideTimeout;
        box.addEventListener('touchstart', () => {
          barContainer.style.opacity = '1';
          barContainer.style.pointerEvents = 'auto';
          barContainer.style.transform = 'scale(1)';
          clearTimeout(hideTimeout);
          // Masquer après 2s si pas d'interaction
          hideTimeout = setTimeout(() => {
            barContainer.style.opacity = '0';
            barContainer.style.pointerEvents = 'none';
            barContainer.style.transform = 'scale(0.95)';
          }, 2000);
        });
      }
    }
  </script>
</Layout>
