---
import Layout from "@layouts/Layout.astro";
import SavingsSection from "@components/SavingsSection.astro";
const { frontmatter } = Astro.props;
---
<Layout title="Discovers our offers">
  <SavingsSection
    title="Discover our offers"
    description="La Casa Que Canta is a small luxury hotel with essence, history and a personality of its own. Located in Zihuatanejo next to the beautiful La Ropa beach, this hotel offers unrivaled panoramic views."
    moreLabel="More details"
    bookLabel="Book Now"
    sectionId="savings-default"
    backgroundImage="/offers/fond-playa.jpg"
  />
</Layout>
