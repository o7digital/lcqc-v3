---
import MichelinLogo from "@components/MichelinLogo.astro";
import Layout from '../layouts/Layout.astro';
import { fetchDatoCMS } from '@lib/datocms';

// Optional DatoCMS page content (fallback to static if unavailable)
const locale = 'en';
let page = null;
try {
  const query = `
    query PageBySlug($slug: String, $locale: SiteLocale) {
      allPages(filter: { slug: { eq: $slug } }, locale: $locale, first: 1) {
        title
        subtitle
        heroImage { url }
        intro
      }
    }
  `;
  const data = await fetchDatoCMS(query, { slug: 'la-casa-que-canta', locale });
  page = data?.allPages?.[0] || null;
} catch(_) { page = null; }
const pageTitle = page?.title || 'La Casa Que Canta';
const pageSubtitle = page?.subtitle || 'Small Luxury Hotel Boutique';
const heroUrl = page?.heroImage?.url || '/lobby.jpg';
// Official client copy (September 2026); keep independent of the CMS intro.
const paragraphs = [
  "Our hotel, with his spectacular views, dominates the marvelous bay of Zihuatanejo Guerrero next to the beautiful La Ropa beach. We have been recognized for the third year with one Key by The MICHELIN Guide.",
  "With two swimming pools, one between the sea and the sky, the other at the sea level with ocean water, our \" Casa Que Canta \" is built with adobe bricks, palapas and tropical woods. The unique architecture of our \"Casa\" is an icon on the Pacific Coast of Mexico. It's 25 Oceanfront ample suites offers unrivaled panoramic views and spacious terraces, spread out among three buildings. We are considered a very romantic hotel by famous magazines and travelers."
];
---

<Layout title={pageTitle}>
  <section class="h-72 bg-center bg-cover" style={`background-image: url(${heroUrl});`}>
  </section>

  <section class="bg-center bg-cover bg-[url('/palm-bg-front.png')] bg-fixed">
    <div class="px-4 grid md:grid-cols-2 py-8 max-w-7xl items-center mx-auto justify-between">
      <div class="mb-8">
        <h2 class="text-5xl lg:text-7xl text-black/90 text-balance font-bold text-center">{pageTitle}</h2>
        <div class="mt-6 flex items-center gap-4 justify-center">
          <img
            src="/images/slh.jpg"
            alt="SLH"
            class="h-[7.8rem] w-auto"
          />
          <MichelinLogo class="h-[5.5rem] w-auto" />
        </div>
      </div>

      <div class="text-justify text-base grid gap-4">
        {paragraphs.map((p) => (<p>{p}</p>))}
      </div>
    </div>
  </section>

  <!-- 🔹 Ahora cada bloque ocupa toda la fila -->
  <section class="grid">
    <!-- History -->
    <div
      class="aspect-[16/9] grid items-end bg-cover"
      style="background-image: image-set(url('/images/welcome-lacasa-optimized.webp?v=3') type('image/webp'), url('/images/welcome-lacasa-optimized.jpg?v=3') type('image/jpeg')); background-position: center center;"
    >
      <div class="p-10">
        <h2 class="text-5xl lg:text-7xl text-white text-balance font-bold">
          History
        </h2>
        <div class="py-6">
          <a href="/history" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">
            See More
          </a>
        </div>
      </div>
    </div>

    <!-- Our Team -->
    <div class="aspect-[16/9] grid items-end bg-[url('/team.jpeg')] bg-cover bg-center">
      <div class="p-10">
        <h2 class="text-5xl lg:text-7xl text-white text-balance font-bold">
          Our Team
        </h2>
      </div>
    </div>

    <!-- Pools -->
    <div
      class="aspect-[16/9] grid items-end bg-cover"
      style="background-image: image-set(url('/pools-new.webp') type('image/webp'), url('/pools-new.jpg') type('image/jpeg')); background-position: center 45%;"
    >
      <div class="p-10">
        <h2 class="text-5xl lg:text-7xl text-white text-balance font-bold">
          Pools
        </h2>
        <mark class="text-base md:text-xl font-bold text-white">
          We offer two pools, an outstanding benefit for our guests
        </mark>
        <div class="py-6">
          <a href="/pools" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">
            See More
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
