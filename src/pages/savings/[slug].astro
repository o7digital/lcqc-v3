---
import LayoutOffer from '@layouts/LayoutOffer.astro';
import { fetchOfferBySlug } from '@lib/fetchOffer';

const { slug } = Astro.params;
const locale = 'en';

// Try Dato first
const dato = await fetchOfferBySlug(slug, locale);

// Load markdown fallback (for book/date/layout props and/or content)
const mods = import.meta.glob('./*.md');
let md = null;
for (const [path, loader] of Object.entries(mods)) {
  if (path.endsWith(`${slug}.md`)) {
    md = await loader();
    break;
  }
}

const frontmatter = {
  title: dato?.title || md?.frontmatter?.title || 'Offer',
  imagefront: dato?.imagefrontUrl || md?.frontmatter?.imagefront || '',
  date: dato?.travelDate || md?.frontmatter?.date || '',
  book: md?.frontmatter?.book || '',
  hideHero: md?.frontmatter?.hideHero ?? true,
  objectPosition: md?.frontmatter?.objectPosition,
  offsetX: md?.frontmatter?.offsetX,
  overlayOffsetX: md?.frontmatter?.overlayOffsetX,
  bookLabel: md?.frontmatter?.bookLabel,
};

const hasDatoContent = Boolean(dato?.description || dato?.terms);
---

<LayoutOffer frontmatter={frontmatter}>
  {hasDatoContent ? (
    <>
      {dato?.description && (
        <div set:html={dato.description} />
      )}

      {dato?.terms && (
        <>
          <hr class="border-white/30 my-4" />
          <b>Terms &amp; Conditions</b>
          <div class="mt-2" set:html={dato.terms} />
        </>
      )}
    </>
  ) : (
    md ? (<md.Content />) : (<p>Offer details coming soon.</p>)
  )}
</LayoutOffer>

