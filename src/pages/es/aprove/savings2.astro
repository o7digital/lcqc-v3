---
import Layout from "../../../layouts/Layout.astro";
import SavingsSection from "@components/SavingsSection.astro";

// Lista curada sin "oferta para nacionales"
const includeSlugs = [
  'discover-us',
  'enchanting-moments',
  'indulge-yourself',
];
---
<Layout title="Aprove – Ofertas (v2)">
  <SavingsSection
    title="Descubre nuestras ofertas"
    description="Previsualización del grid de ofertas con fondo personalizado."
    moreLabel="Más detalles"
    bookLabel="Reservar"
    sectionId="aprove-savings2-es"
    includeSlugs={includeSlugs}
    backgroundImage="/offers/foto-oceano.jpg?v=2"
    backgroundOpacity={0.25}
    backgroundOffsetY="7cm"
  />
</Layout>
