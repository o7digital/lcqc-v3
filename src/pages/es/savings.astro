---
import Layout from '../../layouts/Layout.astro';
import SavingsSection from "../../components/SavingsSection.astro";
const { frontmatter } = Astro.props;
---
<Layout title="Descubre nuestras ofertas">
  <SavingsSection
    title="Descubre nuestras ofertas"
    description="La Casa Que Canta es un pequeño hotel de lujo con esencia, historia y una personalidad propia. Ubicado en Zihuatanejo junto a la hermosa playa La Ropa, este hotel ofrece vistas panorámicas incomparables."
    moreLabel="Más detalles"
    bookLabel="Reservar ahora"
    sectionId="ahorros-default"
    backgroundImage="/offers/fond-playa.jpg"
  />
</Layout>
