---
import Layout from '../../layouts/Layout.astro';
import NewsletterSection from '@components/NewsletterSection.astro';
import { fetchDatoCMS } from '@lib/datocms';

// Optional DatoCMS page content (fallback to static if unavailable)
const locale = 'es';
let page = null;
try {
  const query = `
    query PageBySlug($slug: String, $locale: SiteLocale) {
      allPages(filter: { slug: { eq: $slug } }, locale: $locale, first: 1) {
        title
        subtitle
        heroImage { url }
        intro
      }
    }
  `;
  const data = await fetchDatoCMS(query, { slug: 'la-casa-que-canta', locale });
  page = data?.allPages?.[0] || null;
} catch(_) { page = null; }
const pageTitle = page?.title || 'La Casa Que Canta';
const pageSubtitle = page?.subtitle || 'Pequeño hotel boutique de lujo';
const heroUrl = page?.heroImage?.url || '/lobby.jpg';
const introText = (page?.intro || '').trim();
const introParas = introText ? introText.split(/\r?\n\r?\n+/) : [];
const introNormalized = introText.toLowerCase().replace(/\s+/g, ' ').trim();
const hasMichelinMention = introNormalized.includes('michelin');
const fallbackParas = [
  'Nuestro hotel tiene historia y personalidad propia. Ubicado en Zihuatanejo junto a la hermosa playa La Ropa, ha sido reconocido por segundo año con 1 Llave por la Guía Michelin.',
  'Construido con adobe, palapas y maderas tropicales, la singular arquitectura de nuestra "Casa" es un ícono de la costa del Pacífico mexicano. Sus 25 amplias suites frente al mar ofrecen vistas panorámicas inigualables y terrazas espaciosas, distribuidas en tres edificios.',
  'Considerado el hotel más romántico por prestigiosas revistas y viajeros, fue escenario de la famosa película de Hollywood "Cuando un hombre ama a una mujer".',
];
const oldIntroStart = 'la casa que canta es un pequeño hotel de lujo con esencia, historia y una personalidad propia';
const useDatoIntro = introText && !introNormalized.startsWith(oldIntroStart) && hasMichelinMention;
const paragraphs = useDatoIntro ? introParas : fallbackParas;
---

<Layout title={pageTitle}>
  <section class="h-72 bg-center bg-cover" style={`background-image: url(${heroUrl});`}>
  </section>

  <section class="bg-center bg-cover bg-[url('/palm-bg-front.png')] bg-fixed">
    <div class="px-4 grid md:grid-cols-2 py-8 max-w-7xl items-center mx-auto justify-between">
      <div class="mb-8">
        <h2 class="text-5xl lg:text-7xl text-black/90 text-balance font-bold text-center">{pageTitle}</h2>
        <div class="mt-6 flex items-center gap-4 justify-center">
          <img
            src="/images/slh.jpg"
            alt="SLH"
            class="h-[7.8rem] w-auto"
          />
          <img
            src="/images/1 MICHELIN Key_2025_Round_Red.png"
            alt="Michelin Key 2025"
            class="h-[5.5rem] w-auto"
          />
        </div>
      </div>

      <div class="text-justify text-base grid gap-4">
        {paragraphs.map((p) => (<p>{p}</p>))}
      </div>
    </div>
  </section>

  <section class="grid">
    <!-- Historia -->
    <div
      class="aspect-[16/9] grid items-end bg-cover"
      style="background-image: image-set(url('/images/welcome-lacasa-optimized.webp?v=3') type('image/webp'), url('/images/welcome-lacasa-optimized.jpg?v=3') type('image/jpeg')); background-position: center center;"
    >
      <div class="p-10">
        <h2 class="text-5xl lg:text-7xl text-white text-balance font-bold">
          Historia
        </h2>
        <div class="py-6">
          <a href="/es/history" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">
            Leer más
          </a>
        </div>
      </div>
    </div>

    <!-- Nuestro equipo -->
    <div class="aspect-[16/9] grid items-end bg-cover bg-center" style="background-image: image-set(url('/team.webp') type('image/webp'), url('/team.jpeg') type('image/jpeg'));">
      <div class="p-10">
        <h2 class="text-5xl lg:text-7xl text-white text-balance font-bold">
          Nuestro equipo
        </h2>
        
      </div>
    </div>

    <!-- Piscinas -->
    <div
      class="aspect-[16/9] grid items-end bg-cover"
      style="background-image: image-set(url('/pools-new.webp') type('image/webp'), url('/pools-new.jpg') type('image/jpeg')); background-position: center 45%;"
    >
      <div class="p-10">
        <h2 class="text-5xl lg:text-7xl text-white text-balance font-bold">
          Piscinas
        </h2>
        <mark class="text-base md:text-xl font-bold text-white">
          Ofrecemos dos piscinas, un beneficio excepcional para nuestros huéspedes
        </mark>
        <div class="py-6">
          <a href="/es/pools" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">
            Leer más
          </a>
        </div>
      </div>
    </div>
  </section>

  <NewsletterSection locale="es" />
</Layout>
