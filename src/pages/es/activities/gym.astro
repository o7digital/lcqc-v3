---
import LayoutOneCol from '../../../layouts/LayoutOneCol.astro';
import { fetchDatoCMS } from '@lib/datocms';

const slug = 'gym';
const locale = 'es';
let page = null;
try {
  const query = `
    query PageBySlug($slug: String, $locale: SiteLocale) {
      allPages(filter: { slug: { eq: $slug } }, locale: $locale, first: 1) {
        title
        subtitle
        intro
      }
    }
  `;
  const data = await fetchDatoCMS(query, { slug, locale });
  page = data?.allPages?.[0] || null;
} catch (_) { page = null; }

const fallbackFrontmatter = {
  title: 'Gym',
  layout: '@layouts/LayoutOneCol.astro',
  showBack: false,
  justifyText: true,
  items: [
    { image: '/gym1.jpg', objectPosition: 'center 25%' },
    { image: '/activities/gym-2.jpg' },
    { image: '/activities/gym-3.jpg' },
    { image: '/activities/gym-4.jpg' },
  ],
};

const frontmatter = {
  ...fallbackFrontmatter,
  ...(page ? { title: page.title ?? fallbackFrontmatter.title, description: page.subtitle ?? '' } : {}),
};
const filteredFrontmatter = {
  ...frontmatter,
  // Ocultar la primera foto del gym hasta validación del cliente
  items: (frontmatter.items || []).slice(1),
};
const introText = (page?.intro || '').trim();
const introParas = introText ? introText.split(/\r?\n\r?\n+/).map(p => {
  // Convert **text** to <strong>text</strong>
  let result = p.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Force bold on hours pattern: "Lunes/Día ... — HH:MM – HH:MM hrs"
  result = result.replace(/((?:Lunes|Martes|Miércoles|Jueves|Viernes|Sábado|Domingo|Lun)[^<]*?\d{1,2}:\d{2}[^<]*?hrs?\.?)/gi, '<strong>$1</strong>');
  return result;
}) : [];
---

<LayoutOneCol frontmatter={filteredFrontmatter}>
  {introText ? (
    introParas.map((p) => (<p set:html={p}></p>))
  ) : (
    <>
      <p>
        Donde el movimiento se encuentra con la calma. Bañado por la luz natural y abierto a la brisa del océano, nuestro gimnasio te invita a reconectar con tu energía mientras contemplas la bahía de Zihuatanejo. Con equipo de cardio de última generación y áreas pensadas para fuerza y estiramientos, cada detalle está diseñado para ayudarte a sentirte más fuerte, liviano y presente.
      </p>
      <p><strong>Lunes a domingo — 10:00 – 18:00 hrs.</strong></p>
    </>
  )}

  <div class="mt-10 flex items-center gap-4 justify-center">
    <img
      src="/images/slh.jpg"
      alt="SLH"
      class="h-[7.8rem] w-auto"
    />
    <img
      src="/images/1 MICHELIN Key_2025_Round_Red.png"
      alt="Michelin Key 2025"
      class="h-[5.5rem] w-auto"
    />
  </div>
</LayoutOneCol>
