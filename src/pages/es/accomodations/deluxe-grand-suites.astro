---
import LayoutAccomo from '@layouts/LayoutAccomo.astro';
import { fetchSuiteDetails } from '@lib/fetchSuiteDetails';

const slug = 'deluxe-grand-suites';
const locale = 'es';
const details = await fetchSuiteDetails(slug, locale);

const fallbackFrontmatter = {
  title: 'Deluxe Grand Suites',
  imagefront: '/deluxe-grand-suites/1.jpg',
  book: 'https://be.synxis.com/?adult=1&arrive=2024-07-01&chain=22402&child=0&currency=USD&depart=2024-07-02&hotel=78821&level=hotel&locale=es-ES&room=DGS&rooms=1&src=24C',
  square: '760 – 1,280 ft² | 71 – 120 m²',
  beds: 'Cama King Size',
  guest: '2 huéspedes',
  roomfeatures: [
    { rf: 'Terraza con sala, mesa, sillas y tumbona' },
    { rf: 'Escritorio de trabajo' },
    { rf: 'Vestidor tipo walk-in' },
    { rf: 'Caja de seguridad' },
  ],
  amenities: [
    { a: 'Minibar de cortesía' },
    { a: 'Fruta fresca repuesta diariamente' },
    { a: 'Bebida de bienvenida' },
    { a: 'Tapiz cubrecama artístico decorada con flores frescas' },
    { a: 'Revistas y libros en la habitación' },
    { a: 'Acceso a internet' },
    { a: 'Wi-Fi de cortesía.' },
  ],
  items: [
    { image: '/deluxe-grand-suites/1.jpg' },
    { image: '/deluxe-grand-suites/2.jpg' },
    { image: '/deluxe-grand-suites/3.jpg' },
    { image: '/deluxe-grand-suites/4.jpg' },
    { image: '/deluxe-grand-suites/5.jpg' },
  ],
};

const parseList = (v)=>Array.isArray(v)?v.map(s=>String(s).trim()).filter(Boolean):(typeof v==='string'?v.split(/\r?\n+/).map(s=>s.trim()).filter(Boolean):[]);
const datoFeatures = parseList(details?.roomFeatures).map((rf)=>({rf}));
const rawAmenities = parseList(details?.amenities);
const datoAmenities = (()=>{const arr=rawAmenities.map((a)=>({a})); if(details?.internetAccess && !rawAmenities.some(s=>s.toLowerCase().includes('internet'))) arr.push({a:'Acceso a internet'}); return arr;})();

const frontmatter = { ...fallbackFrontmatter, description: details?.subtitle ?? '', roomfeatures: datoFeatures.length? datoFeatures: fallbackFrontmatter.roomfeatures, amenities: datoAmenities.length? datoAmenities: fallbackFrontmatter.amenities };
const introText = (details?.intro || '').trim();
const introParas = introText ? introText.split(/\r?\n\r?\n+/) : [];
---

<LayoutAccomo frontmatter={frontmatter}>
  {introText ? introParas.map((p)=>(<p>{p}</p>)) : (
    <p>
      Las 10 suites rediseñadas son ahora aún más cómodas y espaciosas, con doble vista a la bahía. Cada suite es única en su distribución, con colores distintivos, mobiliario y decoración mexicana auténtica. Los baños renovados son amplios, luminosos y algunos con vistas al mar.
    </p>
  )}
</LayoutAccomo>
