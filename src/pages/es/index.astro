---
import Layout from '../../layouts/Layout.astro';
import BookingEngine from '@components/BookingEngine.astro';
import { fetchDatoCMS } from '@lib/datocms';

const query = `
{
  allSliders(orderBy: sortOrder_ASC) {
    id
    media {
      url
      focalPoint { x y }
    }
    description
    sortOrder
  }
}
`;
const data = await fetchDatoCMS(query);
const slides = data?.allSliders || [];
const fpParams = (fp) => (fp && typeof fp.x === 'number' && typeof fp.y === 'number') ? `&fp-x=${fp.x}&fp-y=${fp.y}` : '';
// DEV: re-enable booking engine for testing
const hideBooking = false;
---

<Layout title="Bienvenido a La Casa Que Canta">
  <section class="scroll-section grid relative">
    <div class="absolute top-20 right-8 z-10">
      <img class="hidden md:block" src="/logo-white.svg" width="115px" alt="">
    </div>

    <!-- Slider Desktop -->
    <div class="hidden md:block absolute top-0 left-0 w-full h-full overflow-hidden">
      <div class="swiper mySwiper w-full h-full">
        <div class="swiper-wrapper">
          {slides.length > 0 ? slides.map((slide, i) => (
            <div class="swiper-slide">
              <picture>
                <source
                  type="image/avif"
                  srcset={`${slide.media.url}?fm=avif&q=60&w=640 640w, ${slide.media.url}?fm=avif&q=60&w=1280 1280w, ${slide.media.url}?fm=avif&q=60&w=1920 1920w`}
                  sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                />
                <source
                  type="image/webp"
                  srcset={`${slide.media.url}?fm=webp&q=60&w=640 640w, ${slide.media.url}?fm=webp&q=60&w=1280 1280w, ${slide.media.url}?fm=webp&q=60&w=1920 1920w`}
                  sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                />
                <img
                  src={`${slide.media.url}?auto=compress&q=70&w=1280`}
                  srcset={`${slide.media.url}?auto=compress&q=70&w=640 640w, ${slide.media.url}?auto=compress&q=70&w=1280 1280w, ${slide.media.url}?auto=compress&q=70&w=1920 1920w`}
                  sizes="(max-width: 640px) 640px, (max-width: 1280px) 1280px, 1920px"
                  class="w-full h-full object-cover"
                  alt={slide.description || 'Slide'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            </div>
          )) : (
            <div class="swiper-slide bg-black text-white flex items-center justify-center">
              Sin imágenes en el slider
            </div>
          )}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>

    <!-- Slider Mobile (better crop + hint on last) -->
    <div class="md:!hidden swiper mySwiper !absolute h-full w-full top-0 overflow-hidden">
      <div class="swiper-wrapper">
        {slides.length > 0 ? slides.map((slide, i) => (
          <div class="swiper-slide relative">
            <picture>
              <source
                type="image/avif"
                srcset={`${slide.media.url}?fm=avif&q=60&fit=crop&crop=focalpoint&ar=4:5&w=320${fpParams(slide.media.focalPoint)} 320w, ${slide.media.url}?fm=avif&q=60&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(slide.media.focalPoint)} 640w, ${slide.media.url}?fm=avif&q=60&fit=crop&crop=focalpoint&ar=4:5&w=1024${fpParams(slide.media.focalPoint)} 1024w`}
                sizes="100vw"
              />
              <source
                type="image/webp"
                srcset={`${slide.media.url}?fm=webp&q=60&fit=crop&crop=focalpoint&ar=4:5&w=320${fpParams(slide.media.focalPoint)} 320w, ${slide.media.url}?fm=webp&q=60&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(slide.media.focalPoint)} 640w, ${slide.media.url}?fm=webp&q=60&fit=crop&crop=focalpoint&ar=4:5&w=1024${fpParams(slide.media.focalPoint)} 1024w`}
                sizes="100vw"
              />
              <img
                src={`${slide.media.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(slide.media.focalPoint)}`}
                srcset={`${slide.media.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=320${fpParams(slide.media.focalPoint)} 320w, ${slide.media.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=640${fpParams(slide.media.focalPoint)} 640w, ${slide.media.url}?auto=compress&q=70&fit=crop&crop=focalpoint&ar=4:5&w=1024${fpParams(slide.media.focalPoint)} 1024w`}
                sizes="100vw"
                class="w-full h-full object-cover object-center"
                alt={slide.description || 'Slide'}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </picture>
            <!-- Subtle gradient for readability -->
            <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/35 via-black/10 to-transparent pointer-events-none"></div>
            {i === slides.length - 1 && (
              <div class="md:hidden absolute bottom-6 left-1/2 -translate-x-1/2 z-20 text-white text-xs font-semibold flex items-center gap-2 px-3 py-2 bg-black/40 rounded-full backdrop-blur-sm rotate-hint">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 12a10 10 0 0118.36-4.9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M22 12a10 10 0 01-18.36 4.9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  <path d="M16 4l4 2-2-4" fill="currentColor"/>
                  <path d="M8 20l-4-2 2 4" fill="currentColor"/>
                </svg>
                <span>Gira tu teléfono</span>
              </div>
            )}
          </div>
        )) : (
          <div class="swiper-slide bg-black text-white flex items-center justify-center">
            Sin imágenes en el slider
          </div>
        )}
      </div>
      <div class="swiper-pagination"></div>
    </div>

    <!-- Michelin logo overlay inside hero (bottom-right); raise on desktop (~3cm ≈ 120px) to avoid chatbot overlap -->
    <div class="absolute bottom-[54px] md:bottom-[120px] right-4 z-20">
      <img src="/images/1 MICHELIN Key_2025_Round_Red.png" alt="Michelin 2025" class="w-20 md:w-24 h-auto drop-shadow-xl" />
    </div>

    <!-- Contenido -->
    <div class="relative pt-24 md:pt-4 z-10 w-full text-center">
      <div class="mix-blend-difference">
        <h1 class="relative text-4xl md:text-4xl lg:text-5xl xl:text-7xl text-white font-bold">
          La Casa que canta
        </h1>
      </div>
    </div>

    <!-- Booking Engine centrado (hidden while BE disabled) -->
    {hideBooking ? null : (
      <div class="absolute bottom-10 w-full z-20 flex justify-center">
        <div class="booking-hover-zone group" tabindex="0" style="outline:none;">
          <div class="bg-black/10 group-hover:bg-black/20 group-focus-within:bg-black/20 backdrop-blur-sm transition rounded-lg p-4 opacity-0 pointer-events-none scale-95 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:scale-100" id="booking-bar-container">
            <BookingEngine/>
          </div>
        </div>
      </div>
    )}
  </section>

  <script>
    import Swiper from "swiper";
    import { Pagination, Autoplay } from "swiper/modules";
    import "swiper/css";
    import "swiper/css/pagination";

    new Swiper(".mySwiper", {
      modules: [Pagination, Autoplay],
      pagination: { el: ".swiper-pagination", clickable: true },
      autoplay: { delay: 5000, disableOnInteraction: false },
      loop: true,
    });
  </script>

  <style is:global>
    .scroll-section { height: 100vh; position: relative; }
    .swiper, .swiper-slide { width: 100%; height: 100%; }
    /* Hide pagination bullets for hero slider (desktop + mobile) */
    .scroll-section .swiper-pagination { display: none !important; }
    .booking-hover-zone .bg-black\/10 {
      transition: opacity 0.3s, transform 0.3s;
    }
    .rotate-hint { animation: hint-pulse 2.4s ease-in-out infinite; }
    @keyframes hint-pulse {
      0%, 100% { transform: translate(-50%, 0) scale(1); opacity: .95; }
      50% { transform: translate(-50%, -3px) scale(1.02); opacity: 1; }
    }
  </style>
