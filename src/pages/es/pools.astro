---
import Layout from '../../layouts/Layout.astro';
import { fetchDatoCMS } from '@lib/datocms';

const slug = 'pools';
const locale = 'es';
let page = null;
try {
  const query = `
    query PageBySlug($slug: String, $locale: SiteLocale) {
      allPages(filter: { slug: { eq: $slug } }, locale: $locale, first: 1) {
        title
        subtitle
        intro
      }
    }
  `;
  const data = await fetchDatoCMS(query, { slug, locale });
  page = data?.allPages?.[0] || null;
} catch (_) { page = null; }
const pageTitle = page?.title || 'Piscinas';
const pageSubtitle = page?.subtitle || 'Pequeño hotel boutique de lujo';
const introText = (page?.intro || '').trim();
const introParas = introText ? introText.split(/\r?\n\r?\n+/) : [];
---

<Layout title="Descubre nuestras piscinas - La Casa Que Canta">
    <section class="h-72 bg-center bg-cover" style="background-image: image-set(url('/infinity-pool/5.webp') type('image/webp'), url('/infinity-pool/5.jpg') type('image/jpeg'));">
    </section>
    <section class="bg-center bg-cover bg-[url('/palm-bg-front.png')] bg-fixed">
        <div class="px-4 grid md:grid-cols-2 py-16 max-w-7xl items-center mx-auto justify-between ">
            <div class="mb-8">
                <h2 class="text-3xl md:text-5xl lg:text-7xl text-black/90 text-balance font-bold">{pageTitle}</h2>
            </div>
            <div class="text-justify text-base grid gap-4">
                {introText ? (
                  introParas.map((p) => (<p>{p}</p>))
                ) : (
                  <p>Con sus dos magníficas piscinas con vista al Pacífico, La Casa Que Canta ofrece a sus huéspedes un espacio sereno donde el mar y el cielo se vuelven uno.
Entre jardines tropicales, nuestras piscinas invitan a relajarse y a disfrutar de las vistas panorámicas de la bahía de Zihuatanejo —un verdadero santuario de calma y belleza.</p>
                )}
            </div>
        </div>
    </section>
    <section class="grid md:grid-cols-2 mb-32 max-h-screen">
        <div class="col-span-1 md:aspect-video grid items-end bg-cover bg-center" style="background-image: image-set(url('/ocean-water-pool/1.webp') type('image/webp'), url('/ocean-water-pool/1.jpg') type('image/jpeg'));">
			<div class="p-10">
				<h2 class="text-3xl md:text-5xl lg:text-7xl text-white text-balance font-bold">
					Piscina de agua de mar y jacuzzi</h2>
					<div class="py-6">
						<a href="/es/pools/ocean-water-pool" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">Leer más</a>
					</div>
			</div>
		</div>
        <div class="col-span-1 md:aspect-video grid items-end bg-cover bg-center" style="background-image: image-set(url('/infinity-pool/1.webp') type('image/webp'), url('/infinity-pool/1.jpg') type('image/jpeg'));">
			<div class="p-10">
				<h2 class="text-3xl md:text-5xl lg:text-7xl text-white text-balance font-bold">
					Infinity Pool</h2>
					<div class="py-6">
						<a href="/es/pools/infinity-pool" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">Leer más</a>
					</div>
			</div>
		</div>
    </section>
</Layout>
