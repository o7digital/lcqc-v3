---
import LayoutOneCol from '@layouts/LayoutOneCol.astro';
import { fetchDatoCMS } from '@lib/datocms';

const slug = 'gym';
const locale = 'en';
let page = null;
try {
  const query = `
    query PageBySlug($slug: String, $locale: SiteLocale) {
      allPages(filter: { slug: { eq: $slug } }, locale: $locale, first: 1) {
        title
        subtitle
        intro
      }
    }
  `;
  const data = await fetchDatoCMS(query, { slug, locale });
  page = data?.allPages?.[0] || null;
} catch (_) { page = null; }

const fallbackFrontmatter = {
  title: 'Gym',
  layout: '@layouts/LayoutOneCol.astro',
  showBack: false,
  justifyText: true,
  items: [
    { image: '/gym1.jpg', objectPosition: 'center 25%' },
    { image: '/activities/gym-2.jpg' },
    { image: '/activities/gym-3.jpg' },
    { image: '/activities/gym-4.jpg' },
  ],
};

const frontmatter = {
  ...fallbackFrontmatter,
  ...(page ? { title: page.title ?? fallbackFrontmatter.title, description: page.subtitle ?? '' } : {}),
};
const filteredFrontmatter = {
  ...frontmatter,
  // Hide first gym visual until client approves; keep rest live
  items: (frontmatter.items || []).slice(1),
};
const introText = (page?.intro || '').trim();
const introParas = introText ? introText.split(/\r?\n\r?\n+/).map(p => {
  // Convert **text** to <strong>text</strong>
  let result = p.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  // Force bold on hours pattern: "Day/Days ... — HH:MM – HH:MM hrs"
  result = result.replace(/((?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)[^<]*?\d{1,2}:\d{2}[^<]*?hrs?\.?)/gi, '<strong>$1</strong>');
  return result;
}) : [];
---

<LayoutOneCol frontmatter={filteredFrontmatter}>
  {introText ? (
    <>
      {introParas.map((p) => (<p set:html={p}></p>))}
      <div class="mt-10 flex items-center gap-4 justify-center">
        <img
          src="/images/slh.jpg"
          alt="SLH"
          class="h-[7.8rem] w-auto"
        />
        <img
          src="/images/1 MICHELIN Key_2025_Round_Red.png"
          alt="Michelin Key 2025"
          class="h-[5.5rem] w-auto"
        />
      </div>
    </>
  ) : (
    <>
      <p>
        Where movement meets calm. Bathed in natural light and open to the ocean breeze, our gym invites you to reconnect with your energy while gazing over Zihuatanejo Bay. With state-of-the-art cardio equipment and thoughtfully designed areas for strength and stretching, every detail is crafted to help you feel stronger, lighter, and more present. Start at sunrise or unwind at sunset — let the rhythm of the bay set your pace.
      </p>
      <p><strong>Monday through Sunday — 10:00 – 18:00 hrs.</strong></p>
    </>
  )}

  <div class="mt-10 flex items-center gap-4 justify-center">
    <img
      src="/images/slh.jpg"
      alt="SLH"
      class="h-[7.8rem] w-auto"
    />
    <img
      src="/images/1 MICHELIN Key_2025_Round_Red.png"
      alt="Michelin Key 2025"
      class="h-[5.5rem] w-auto"
    />
  </div>
</LayoutOneCol>
