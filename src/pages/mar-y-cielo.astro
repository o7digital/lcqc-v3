---
import LayoutOneCol from '@layouts/LayoutOneCol.astro';
import { fetchDatoCMS } from '@lib/datocms';

const slug = 'mar-y-cielo';
const locale = 'en';
let page = null;
try {
  const query = `
    query PageBySlug($slug: String, $locale: SiteLocale) {
      allPages(filter: { slug: { eq: $slug } }, locale: $locale, first: 1) {
        title
        subtitle
        intro
      }
    }
  `;
  const data = await fetchDatoCMS(query, { slug, locale });
  page = data?.allPages?.[0] || null;
} catch (_) { page = null; }

const fallbackFrontmatter = {
  title: 'Mar y Cielo',
  description: 'Seafood from the diversity of Zihuatanejo’s coast',
  layout: '@layouts/LayoutOneCol.astro',
  showAwards: false,
  justifyText: true,
  showBack: false,
  items: [
    { image: '/mar-y-cielo/1.jpeg' },
    { image: '/mar-y-cielo/2.jpeg' },
    { image: '/mar-y-cielo/3.jpeg' },
    { image: '/mar-y-cielo/4.jpeg' },
    { image: '/mar-y-cielo/4.jpg' },
    { image: '/mar-y-cielo/5.jpg' },
    { image: '/mar-y-cielo/6.jpg' },
    { image: '/mar-y-cielo/7.jpg' },
    { image: '/mar-y-cielo/8.jpg' },
    { image: '/mar-y-cielo/9.jpg' },
    { image: '/mar-y-cielo/10.jpg' },
    { image: '/mar-y-cielo/11.jpg' },
  ],
};

const frontmatter = {
  ...fallbackFrontmatter,
  ...(page ? { title: page.title ?? fallbackFrontmatter.title, description: page.subtitle ?? fallbackFrontmatter.description } : {}),
};

const introText = (page?.intro || '').trim();
const introParas = introText ? introText.split(/\r?\n\r?\n+/) : [];
---

<LayoutOneCol frontmatter={frontmatter}>
  {introText ? (
    introParas.map((p) => (<p>{p}</p>))
  ) : (
    <>
      <p>
        Our seafood is freshly caught every morning from the pristine waters of Zihuatanejo’s coast, ensuring the finest flavors of the Pacific on your plate. Each dish celebrates the meeting of two culinary worlds — traditional Mexican recipes and delicate Mediterranean inspiration — crafted with seasonal ingredients and local passion.
      </p>
      <p>
        This rare tradition, passed down by generations of fishermen, transforms every meal into an authentic experience of coastal Mexico, where freshness, flavor, and artistry meet by the sea.
      </p>
      <p><strong>Dinner — From 18:00 to 22:30 hrs.</strong></p>
      <div class="mt-8 flex justify-center">
        <a href="https://www.opentable.com.mx/r/mar-y-cielo-zihuatanejo" target="_blank" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">Book a table</a>
      </div>
      <div class="mt-10 flex items-center gap-4 justify-center">
        <img
          src="/images/slh.jpg"
          alt="SLH"
          class="h-[7.8rem] w-auto"
        />
        <img
          src="/images/1 MICHELIN Key_2025_Round_Red.png"
          alt="Michelin Key 2025"
          class="h-[5.5rem] w-auto"
        />
      </div>
    </>
  )}
</LayoutOneCol>

