---
import sliderImages from "../data/slider-images.json";
import MichelinLogo from "@components/MichelinLogo.astro";
import Layout from "../layouts/Layout.astro";
const { frontmatter } = Astro.props;
const showBack = frontmatter?.showBack !== false;
const imageManifest = sliderImages as Record<string, { width: number; height: number; variants: { src: string; width: number }[] }>;
const optimizedGallery = frontmatter.items?.length > 0 && frontmatter.items.every((item) => imageManifest[item.image]);
---

<Layout title={`${frontmatter.title} - La Casa Que Canta`}>

<section class="grid w-full md:grid-cols-[65%_35%] md:h-screen overflow-y-hidden">
  <div class:list={["min-w-0", { "optimized-gallery": optimizedGallery }]}>
    <div class="swiper mySwiper activities-slider w-full max-w-full overflow-hidden relative">
      {frontmatter.showMichelin !== false && (
        <div class="absolute top-4 right-4 z-30 hidden md:block">
          <MichelinLogo class="w-24 h-auto drop-shadow-xl" />
        </div>
      )}
      <div class="swiper-wrapper">
        {Array.isArray(frontmatter.items) && frontmatter.items.map((item, index) => {
          const optimized = imageManifest[item.image];
          const webp = item.image.replace(/\.(jpg|jpeg|png)$/i, '.webp');
          return (
          <div class="swiper-slide">
            <picture>
              <source
                srcset={optimized ? optimized.variants.map((variant) => `${variant.src} ${variant.width}w`).join(', ') : webp}
                sizes={optimized ? '(min-width: 768px) 65vw, 100vw' : undefined}
                type="image/webp"
              />
              <img
                class="cursor-pointer object-cover object-[40%_20%] md:object-[center_20%] transition duration-300 ease-in-out w-full h-full"
                src={item.image}
                alt={item.text || frontmatter.title}
                width={optimized?.width}
                height={optimized?.height}
                loading={optimizedGallery ? (index === 0 ? 'eager' : 'lazy') : undefined}
                fetchpriority={optimizedGallery && index === 0 ? 'high' : undefined}
                decoding={optimizedGallery ? 'async' : undefined}
              />
            </picture>
            {item.text && (
              <div class="slide-caption">{item.text}</div>
            )}
          </div>
          );
        })}
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>

  <div class="min-w-0 px-8 grid items-center my-8 prose-base md:px-12 lg:px-16">
    <div>
      <div class="mb-6">
        <h1 class="text-5xl lg:text-7xl font-bold">{frontmatter.title}</h1>
        {frontmatter.description && (
          <span class="font-bold">{frontmatter.description}</span>
        )}
      </div>
      <slot />
      {showBack && (
        <div class="mt-10">
          <a href="/" class="bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">
            {Astro.url.pathname.startsWith('/es') ? 'Regresar Home' : 'Back to Home'}
          </a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Reserve the gallery space before images and Swiper finish loading. */
  .optimized-gallery {
    height: 65svh;
    min-height: 20rem;
  }
  .optimized-gallery .swiper {
    height: 100%;
  }
  .optimized-gallery picture {
    display: block;
    height: 100%;
  }
  .optimized-gallery .swiper:not(.swiper-initialized) .swiper-slide {
    width: 100%;
    flex: 0 0 100%;
  }
  @media (min-width: 768px) {
    .optimized-gallery {
      height: 100vh;
      min-height: 0;
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Pagination, Autoplay } from "swiper/modules";

  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";

  new Swiper(".mySwiper", {
    modules: [Pagination, Autoplay],
    spaceBetween: 30,
    centeredSlides: true,
    loop: true,
    autoplay: {
      delay: 4000,
      disableOnInteraction: false,
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
  });
</script>

</Layout>
