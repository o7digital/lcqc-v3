---
import Layout from "../layouts/Layout.astro";
const { frontmatter } = Astro.props;
const offers = await Astro.glob("../pages/savings/*.md");
const suggestedoffers = offers.filter(
  (room) => room.frontmatter.title !== frontmatter.title
);
---

<Layout title={`${frontmatter.title} Offers - La Casa Que Canta`}>
  <section class="relative">
    <!-- Hero image -->
    <div class="relative">
      <img class="w-full h-[60vh] md:h-[75vh] object-cover" src={frontmatter.imagefront} alt="" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/40 to-transparent"></div>

      <!-- Centered title tag over the image -->
      <div class="absolute top-6 left-0 right-0 flex justify-center px-4">
        <span class="uppercase tracking-widest text-sm md:text-base bg-black/60 text-white px-4 py-2 rounded">
          {frontmatter.title}
        </span>
      </div>

      <!-- Content panel overlay -->
      <div class="absolute bottom-0 left-0 right-0 md:left-8 md:right-auto md:bottom-10 px-4 md:px-0">
        <div class="max-w-xl md:max-w-lg bg-black/55 backdrop-blur-sm text-white p-6 md:p-8 rounded-t md:rounded">
          <div class="prose prose-invert max-w-none text-white">
            <slot />
          </div>

          <hr class="border-white/20 my-4" />
          <div class="text-white/90 mb-2">
            <b>Travel:</b>
            <div>From {frontmatter.date}</div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mt-4">
            <div class="text-sm leading-relaxed">
              Direct : 755 555 7000<br />
              USA : 1 888 523 5050<br />
              552 564 1838<br />
              <a class="underline" href="mailto:sales.reservations@lacasaquecanta.com">sales.reservations@lacasaquecanta.com</a>
            </div>
            <div class="flex-shrink-0">
              <a href={frontmatter.book} class="inline-block bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-semibold px-5 py-3 rounded">Book Now</a>
            </div>
          </div>

          <div class="mt-4">
            <a href="/savings" class="underline">View More Offers</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Suggested offers grid -->
    <div class="grid grid-cols-2 px-4 md:grid-cols-3 gap-6 max-w-7xl mx-auto py-16">
      <div class="col-span-2 md:col-span-1">
        <h2 class="text-5xl mb-6">Discover more offers</h2>
        <p>
          La Casa Que Canta is a small luxury hotel with essence,
          history and a personality of its own. Located in Zihuatanejo
          next to the beautiful La Ropa beach, this hotel offers
          unrivaled panoramic views.
        </p>
      </div>

      {suggestedoffers.slice(0, 5).map((post) => (
        <a
          href={post.url}
          class="group relative bg-cover bg-center p-2 md:p-10 aspect-square grid items-end text-white overflow-hidden"
        >
          <div class="absolute z-10 w-full h-full top-0 bg-gradient-to-br from-transparent to-gray-900 opacity-60"></div>
          <img
            class="absolute z-0 w-full h-full top-0 object-cover group-hover:scale-[1.02] transition duration-300 ease-in-out"
            src={post.frontmatter.imagefront}
            alt=""
          />
          <h3 class="text-xl md:text-5xl z-20 relative">{post.frontmatter.title}</h3>
        </a>
      ))}
    </div>
  </section>
</Layout>
