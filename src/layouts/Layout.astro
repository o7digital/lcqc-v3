---
import Header from '../components/Header.astro';
import Footer from "../components/Footer.astro"
import CookieBanner from "../components/CookieBanner.astro"
import "../styles/global.css";
interface Props {
    title: string;
    description?: string;
    ogImage?: string;
}

const { title, description, ogImage } = Astro.props as Props;
const defaultDescription =
  'La Casa Que Canta, the iconic luxury hotel in Zihuatanejo, Guerrero, Mexico. Official website – experience timeless elegance, sea views, and Mexican artistry.';
const metaDescription = description ?? defaultDescription;
const metaOgImage = ogImage ?? '/panorama-lcqc.jpg';
const isEs = Astro.url.pathname.startsWith('/es');
const metaKeywords = isEs
  ? 'hotel boutique de playa zihuatanejo, hotel boutique de lujo ixtapa zihuatanejo, hotel boutique romántico zihuatanejo, hoteles boutique ixtapa zihuatanejo, hoteles boutique de lujo zihuatanejo, hoteles boutique románticos zihuatanejo, hoteles boutique de playa zihuatanejo, hoteles boutique ixtapa zihuatanejo, hoteles boutique de lujo ixtapa zihuatanejo, hoteles boutique románticos ixtapa zihuatanejo, hoteles boutique exclusivos zihuatanejo, hoteles boutique de lujo méxico, hoteles boutique románticos méxico, hoteles boutique de playa méxico, hoteles boutique exclusivos méxico, hoteles boutique méxico, hoteles boutique románticos ixtapa zihuatanejo, hoteles boutique de playa ixtapa zihuatanejo, hoteles boutique exclusivos ixtapa zihuatanejo, hoteles boutique románticos zihuatanejo, hotel boutique romántico frente al mar zihuatanejo, mejores hoteles boutique para parejas en ixtapa, escapadas románticas zihuatanejo méxico, hoteles boutique para luna de miel en zihuatanejo, pequeño hotel boutique romántico cerca de zihuatanejo, hoteles boutique cerca de playa la ropa zihuatanejo, hoteles boutique con vista al mar ixtapa zihuatanejo, hoteles boutique tranquilos en zihuatanejo, mejores hoteles boutique frente a la playa en el pacífico méxico, hoteles boutique junto al mar en guerrero méxico, hoteles boutique de lujo solo adultos ixtapa zihuatanejo, hoteles boutique exclusivos frente al mar méxico, hoteles boutique de alta gama en la costa del pacífico méxico, mejores retiros boutique de lujo en zihuatanejo, hoteles boutique de lujo con piscina privada méxico, hoteles boutique con servicio personalizado méxico, hoteles boutique con spa en zihuatanejo, hoteles boutique de bienestar en el pacífico méxico, hoteles boutique con alta cocina en zihuatanejo, hoteles boutique premiados méxico'
  : 'beach boutique hotel zihuatanejo, luxury boutique hotel ixtapa zihuatanejo, romantic boutique hotel zihuatanejo, boutique hotels ixtapa zihuatanejo, luxury boutique hotels zihuatanejo, romantic boutique hotels zihuatanejo, beach boutique hotels zihuatanejo, boutique hotels ixtapa zihuatanejo, luxury boutique hotels ixtapa zihuatanejo, romantic boutique hotels ixtapa zihuatanejo, exclusive boutique hotels zihuatanejo, luxury boutique hotels mexico, romantic boutique hotels mexico, beach boutique hotels mexico, exclusive boutique hotels mexico, boutique hotels mexico, romantic boutique hotels ixtapa zihuatanejo, beach boutique hotels ixtapa zihuatanejo, exclusive boutique hotels ixtapa zihuatanejo, romantic boutique hotels zihuatanejo, romantic oceanfront boutique hotel zihuatanejo, best boutique hotels for couples in ixtapa, romantic getaways zihuatanejo mexico, honeymoon boutique hotels in zihuatanejo, small romantic boutique hotel near zihuatanejo, boutique hotels near playa la ropa zihuatanejo, ocean view boutique hotels ixtapa zihuatanejo, quiet boutique hotels in zihuatanejo, best beachfront boutique hotels pacific mexico, seaside boutique hotels in guerrero mexico, adults-only luxury boutique hotels ixtapa zihuatanejo, exclusive oceanfront boutique hotels mexico, high-end boutique hotels pacific coast mexico, best luxury boutique retreats in zihuatanejo, luxury boutique hotels with private pools mexico, boutique hotels with personalized service mexico, boutique hotels with spa in zihuatanejo, wellness boutique hotels pacific mexico, boutique hotels with fine dining zihuatanejo, award-winning boutique hotels mexico';
const isVercelPreview = process.env.VERCEL_ENV === 'preview';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={metaDescription} />
		<meta name="viewport" content="width=device-width" />
		{metaKeywords && <meta name="keywords" content={metaKeywords} />}
		{isVercelPreview && <meta name="robots" content="noindex,nofollow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=La+Belle+Aurore&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script
			id="Cookiebot"
			src="https://consent.cookiebot.com/uc.js"
			data-cbid="4da3c72f-f612-489f-b764-912635deb8d5"
			data-blockingmode="auto"
			type="text/javascript">
		</script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-FLBSN6KCTV"></script>
		<script>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-FLBSN6KCTV');
		</script>

		<!-- Open Graph -->
		<meta property="og:title" content={title}>
		<meta property="og:description" content={metaDescription}>
		<meta property="og:image" content={metaOgImage}>

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={metaDescription}>
		{isVercelPreview && (
		  <>
		    <style is:inline>
		      {`/* Hide Vercel Toolbar only on Preview */
		      [aria-label*="Vercel"],
		      .vercel-toolbar,
		      #vercel-toolbar,
		      [data-vercel-toolbar],
		      [class*="vercel-toolbar"],
		      iframe[src*="vercel"],
		      div[id*="vercel"],
		      div[class*="vercel-toolbar"],
		      button[aria-label*="Vercel"],
		      a[aria-label*="Vercel"] {
		        display: none !important;
		        visibility: hidden !important;
		        opacity: 0 !important;
		      }`}
		    </style>
		    <script is:inline>
		      {`try {
		        // Also set an opt-out cookie if supported
		        document.cookie = 'vercelToolbar=0; Max-Age=31536000; Path=/';
		        const selectors = [
		          '[aria-label*="Vercel"]', '.vercel-toolbar', '#vercel-toolbar', '[data-vercel-toolbar]',
		          '[class*="vercel-toolbar"]', 'iframe[src*="vercel"]', 'div[id*="vercel"]', 'div[class*="vercel-toolbar"]',
		          'button[aria-label*="Vercel"]', 'a[aria-label*="Vercel"]'
		        ];
		        const hideToolbar = () => {
		          selectors.forEach(sel => document.querySelectorAll(sel).forEach(el => {
		            try { el.remove(); } catch(_) { try { el.style.display = 'none'; } catch(__){} }
		          }));
		          // Remove buttons whose label text matches
		          Array.from(document.querySelectorAll('button, a, div')).forEach(el => {
		            if ((el.textContent || '').trim().toLowerCase().includes('vercel toolbar')) {
		              try { el.remove(); } catch(_) { el.style.display='none'; }
		            }
		          });
		        };
		        const obs = new MutationObserver(() => hideToolbar());
		        obs.observe(document.documentElement, { childList: true, subtree: true });
		        hideToolbar();
		      } catch (e) { /* noop */ }`}
		    </script>
		  </>
		)}
		<script>
			setTimeout(function() {
			  var script = document.createElement('script');
			  script.src = 'https://cdn-cookieyes.com/client_data/f13ecb461f7f38103a4b13c4/script.js';
			  document.head.appendChild(script);
			}, 6000); // 6 seconds delay
		</script>

		<!-- Schema.org JSON-LD for Hotel/LocalBusiness -->
		<script type="application/ld+json">
		{
		  "@context": "https://schema.org",
		  "@type": "Hotel",
		  "name": "La Casa Que Canta",
		  "description": {isEs 
		    ? "Hotel boutique de lujo frente al mar en Zihuatanejo, México. Experiencia romántica exclusiva con vistas al océano Pacífico." 
		    : "Luxury oceanfront boutique hotel in Zihuatanejo, Mexico. Exclusive romantic experience with Pacific Ocean views."},
		  "image": "https://www.lacasaquecanta.com/panorama-lcqc.jpg",
		  "starRating": {
		    "@type": "Rating",
		    "ratingValue": "5"
		  },
		  "address": {
		    "@type": "PostalAddress",
		    "streetAddress": "Camino Escénico at Playa La Ropa S/N",
		    "addressLocality": "Zihuatanejo",
		    "addressRegion": "Guerrero",
		    "postalCode": "40880",
		    "addressCountry": "MX"
		  },
		  "geo": {
		    "@type": "GeoCoordinates",
		    "latitude": "17.6266",
		    "longitude": "-101.5556"
		  },
		  "telephone": "+52-755-555-7000",
		  "email": "sales.reservations@lacasaquecanta.com",
		  "url": "https://www.lacasaquecanta.com",
		  "priceRange": "$$$$",
		  "amenityFeature": [
		    { "@type": "LocationFeatureSpecification", "name": "Infinity Pool" },
		    { "@type": "LocationFeatureSpecification", "name": "Ocean View" },
		    { "@type": "LocationFeatureSpecification", "name": "Spa" },
		    { "@type": "LocationFeatureSpecification", "name": "Restaurant" },
		    { "@type": "LocationFeatureSpecification", "name": "Private Pools" },
		    { "@type": "LocationFeatureSpecification", "name": "WiFi" },
		    { "@type": "LocationFeatureSpecification", "name": "Adults Only" }
		  ],
		  "openingHoursSpecification": {
		    "@type": "OpeningHoursSpecification",
		    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
		    "opens": "09:00",
		    "closes": "18:00"
		  },
		  "sameAs": [
		    "https://www.facebook.com/LaCasaQueCantaLuxuryHotel/",
		    "https://www.instagram.com/lacasaquecanta_hotelboutique/",
		    "https://www.tripadvisor.com/Hotel_Review-g150795-d152932-Reviews-La_Casa_Que_Canta-Zihuatanejo_Zihuatanejo_de_Azueta_Pacific_Coast.html"
		  ]
		}
		</script>
	</head>
	<body>
		<main>
			<div class="scroll-wrapper" id="wrapper">
				<Header/>
				<slot />
												<Footer/>
												<CookieBanner/>
																<!-- Logo Michelin overlay sur le slider, sauf Mar y Cielo -->
																<!-- Rien ici, tout passe dans LayoutOneCol.astro et LayoutTwoCol.astro -->

				<!-- ❌ Eliminado bloque duplicado de dirección/correo -->
				 
				<!--
				  WhatsApp floating button (commented out).
				  To re-enable, remove comment markers and adjust the phone number.
				  Previously visible only on desktop via Tailwind classes.
				  <div id="whatsapp-icon" class="hidden md:fixed md:bottom-4 md:right-4 md:z-50 md:block">
				    <a href="https://wa.me/yourphonenumber" target="_blank" class="flex items-center justify-center w-12 h-12 bg-green-500 rounded-full shadow-lg hover:bg-green-600">
				      <svg xmlns="http://www.w3.org/2000/svg" fill="white" viewBox="0 0 24 24" class="w-6 h-6">
				        <path d="M20.52 3.48C18.32 1.28 15.21 0 12 0 5.373 0 0 5.373 0 12c0 2.135.557 4.173 1.614 5.978L.057 23.942l6.086-1.602C8.316 23.443 10.156 24 12 24c6.627 0 12-5.373 12-12 0-3.21-1.28-6.32-3.48-8.52zM12 22.081c-1.813 0-3.593-.486-5.137-1.405l-.367-.214-3.615.951.964-3.524-.235-.376C2.514 15.576 2.043 13.803 2.043 12 2.043 6.558 6.558 2.043 12 2.043c2.61 0 5.186 1.016 7.069 2.899 1.883 1.883 2.898 4.46 2.898 7.068-.001 5.441-4.516 9.957-10.006 9.957z"></path>
				        <path d="M16.387 14.605c-.276-.138-1.635-.807-1.89-.897-.254-.091-.44-.138-.625.139-.184.276-.716.898-.88 1.082-.164.184-.323.207-.599.069-.276-.138-1.163-.428-2.216-1.366-.819-.73-1.375-1.633-1.535-1.909-.161-.276-.017-.424.122-.562.126-.125.276-.322.414-.483.138-.161.184-.276.276-.46.092-.185.046-.346-.023-.484-.069-.138-.625-1.506-.854-2.05-.224-.537-.451-.466-.625-.476-.161-.007-.345-.009-.53-.009-.184 0-.484.069-.738.346-.254.276-.97.947-.97 2.306 0 1.359.993 2.67 1.132 2.851.138.184 1.954 3.078 4.74 4.315.662.286 1.179.456 1.582.584.665.211 1.271.182 1.75.111.534-.08 1.635-.668 1.867-1.31.23-.643.23-1.194.161-1.31-.069-.115-.253-.184-.53-.322z"></path>
				      </svg>
				    </a>
				  </div>
				-->

			</div>
		</main>


		<script>
			(function(){
			  function loadTidio(){
			    if (window.innerWidth > 768) {
			      var tidioScript = document.createElement('script');
			      tidioScript.src = '//code.tidio.co/k623dmbmwdep8abexdq2uebfg3yoo23f.js';
			      tidioScript.async = true;
			      document.body.appendChild(tidioScript);
			    }
			  }
			  var consent = localStorage.getItem('cookieConsent');
			  if (consent === 'accepted') {
			    setTimeout(loadTidio, 20000);
			  } else {
			    // Espera a la decisión del usuario
			    window.addEventListener('cookie-consent-change', function(e){
			      if (e.detail === 'accepted') setTimeout(loadTidio, 500);
			    });
			  }
			})();
		</script>	

        

		<script src="../scripts/app"></script>
	</body>
</html>

<style is:global>
	html {
		font-family: system-ui, sans-serif;
	}

	body::-webkit-scrollbar {
	  width: 1.25em;
	}

	body::-webkit-scrollbar-track {
	  box-shadow: inset 0 0 6px rgba(0, 0, 0, 0.3);
	}

	body::-webkit-scrollbar-thumb {
	  background-color: darkgrey;
	}

	::-webkit-calendar-picker-indicator {
	    filter: invert(1);
	}

	.swiper{
		height:100%;
	}
	.swiper-wrapper{
		width:100%;
		max-width: 100vw;
		max-height: 100%;
		min-height:0;
		min-width:0;
	}
	.swiper-slide{
		width:auto;
		flex-shrink:0;
		display:block;
		height: 100%;
		max-height: 100%;
	}

	.swiper-pagination-bullet{
		width:15px!important;
		height:15px!important;
		background-color: rgb(255, 255, 255)!important;
		opacity: 0.6!important;
	}

	.swiper-pagination-bullet-active{
		background-color:white!important;
		opacity:1!important;
	}

	/* Hide all Swiper pagination dots sitewide (EN/ES, all sliders) */
	.swiper-pagination,
	.swiper-pagination-bullets,
	.swiper-pagination-bullet { 
		display: none !important; 
	}

	mark{
		font-family: "La Belle Aurore", cursive;
		background-color: transparent;
	}

	body{
		font-family: "Montserrat", sans-serif;
		background-color: #f5f5f5;
	}

	h1,h2,h3, .heading-1, .heading-2,.heading-3{
		font-family: "Bebas Neue", sans-serif;
	}

	.p-relative { position: relative; }
	.langue { position: absolute; top: 15px; right: 10px; }
	.bg-suites-feuille {
		background-image: url('/images/palm-bg-layout.png');
		background-position: bottom;
		height: 200px;
		background-repeat: no-repeat;
		background-position-x: center;
	}
	@media(max-width:768px) {
		.dp_none { display:none }
	}
</style>
