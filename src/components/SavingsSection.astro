---
const {
  title = "Discover our offers",
  description = "",
  moreLabel = "More details",
  bookLabel = "Book Now",
  sectionId = "savings-section",
  backgroundImage = undefined,
  offsetX = '0',
} = Astro.props;

// Load EN or ES offers based on current path (Astro.glob must be static)
const isES = Astro.url.pathname.startsWith('/es');
const offersES = await Astro.glob('/src/pages/es/savings/*.md');
const offersEN = await Astro.glob('/src/pages/savings/*.md');
const offers = isES ? offersES : offersEN;
---
<section id={sectionId} class="py-32">
  <div class="grid max-w-7xl mx-auto">
    <div class="max-w-4xl px-4 mx-auto mb-10 text-center">
      <h1 class="text-3xl md:text-5xl lg:text-7xl mb-6 font-bold">{title}</h1>
      {description && (
        <p>{description}</p>
      )}
    </div>
  </div>
  <div class="relative w-full py-8">
    {backgroundImage && (
      <>
        <div
          class="absolute inset-0 -z-10"
          style={`background-image:url(${backgroundImage}); background-size:cover; background-position:center; background-repeat:no-repeat; opacity:0.9; filter:saturate(1.05) contrast(1.05) hue-rotate(-6deg);`}
        ></div>
        <div class="absolute inset-0 z-0 bg-blue-600/10 mix-blend-soft-light"></div>
        <div class="absolute inset-0 z-0 bg-gradient-to-b from-black/25 via-black/10 to-transparent"></div>
      </>
    )}
    <div class="relative z-10 grid gap-6 grid-cols-1 px-4 md:grid-cols-3 max-w-7xl mx-auto" style={`transform: translateX(${offsetX});`}>
    {offers.slice(0, 6).map((post) => (
      <div class="group relative bg-cover bg-center aspect-square grid items-end text-white overflow-hidden">
        <div class="absolute z-10 w-full h-full top-0 bg-gradient-to-br from-transparent to-gray-900 opacity-60"></div>
        <img class="absolute z-0 w-full h-full top-0 object-cover group-hover:scale-[1.02] transition duration-300 ease-in-out" src={post.frontmatter.imagefront} alt="" />
        <h3 class="text-3xl md:text-5xl z-20 relative text-center">{post.frontmatter.title}</h3>
        <div>
          <p class="text-white relative z-10 p-4 text-center" set:html={post.frontmatter.description}></p>
          <div class="flex flex-wrap p-4 gap-4 justify-center md:justify-between">
            <a href={post.url} class="relative text-sm z-10 bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">{moreLabel}</a>
            <a href={post.url} class="relative text-sm z-10 bg-white/90 font-semibold uppercase py-3 px-6 text-black hover:bg-white/60">{bookLabel}</a>
          </div>
        </div>
      </div>
    ))}
    </div>
  </div>
  
</section>
