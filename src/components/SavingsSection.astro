---
const {
  title = "Discover our offers",
  description = "",
  moreLabel = "More details",
  bookLabel = "Book Now",
  sectionId = "savings-section",
  backgroundImage = undefined,
  backgroundOpacity = 0.25,
  backgroundOffsetX = '0',
  backgroundOffsetY = '0',
  offsetX = '0',
  includeSlugs = undefined,
  // DatoCMS integration (optional)
  useDato = false,
  datoLinkBase = undefined,
} = Astro.props;

// Load EN or ES offers based on current path (Astro.glob must be static)
const isES = Astro.url.pathname.startsWith('/es');
let offers = [];
let selectedOffers = [];

if (useDato) {
  try {
    const { fetchDatoCMS } = await import('@lib/datocms');
    const locale = isES ? 'es' : 'en';
  const query = `
      query AllOffers($locale: SiteLocale) {
        allOffers(filter: { active: { eq: true } }, orderBy: order_ASC, locale: $locale) {
          id
          title
          slug
          subtitle
          description
          imagefront { url }
        }
      }
    `;
    const data = await fetchDatoCMS(query, { locale });
    const base = datoLinkBase ?? (isES ? '/es/savings/' : '/savings/');
    const datoOffers = (data?.allOffers || []).map((o) => ({
      url: `${base}${o.slug}`,
      frontmatter: {
        title: o.title,
        // Grid text must use the short subtitle; fallback to description if needed
        description: o.subtitle || o.description || '',
        imagefront: o?.imagefront?.url || '',
      },
    }));
    offers = datoOffers;
  } catch (e) {
    // Fail silently and fallback to markdown
    offers = [];
  }
}

if (!useDato || offers.length === 0) {
  const offersES = await Astro.glob('/src/pages/es/savings/*.md');
  const offersEN = await Astro.glob('/src/pages/savings/*.md');
  offers = isES ? offersES : offersEN;
}

// Optional filtering by slug (filename or dato slug). If provided, only include matching pages.
selectedOffers = Array.isArray(includeSlugs) && includeSlugs.length
  ? offers.filter((post) => {
      const segs = (post.url || '').split('/').filter(Boolean);
      const last = segs[segs.length - 1] || '';
      return includeSlugs.includes(last);
    })
  : offers;
---
<section id={sectionId} class="pt-20 md:pt-32 pb-0">
  <div class="grid max-w-7xl mx-auto">
    <div class="max-w-4xl px-4 mx-auto mb-10 text-center">
      <h1 class="text-3xl md:text-5xl lg:text-7xl mb-6 font-bold">{title}</h1>
      {description && (
        <p>{description}</p>
      )}
    </div>
  </div>
  <!-- Background block extends down to just before footer -->
  <div class="relative w-full pt-8 pb-20 md:pb-32">
    {backgroundImage && (
      <>
        <div
          class="absolute inset-0 -z-10"
          style={`background-image:url(${backgroundImage}); background-size:100% auto; background-position-x: calc(50% + ${backgroundOffsetX}); background-position-y: calc(100% - ${backgroundOffsetY}); background-repeat:no-repeat;`}
        ></div>
        <div
          class="absolute inset-0 z-0"
          style={`background-color: rgba(0,0,0, ${backgroundOpacity});`}
        ></div>
      </>
    )}
    <div class="relative z-10 grid gap-6 grid-cols-1 px-4 md:grid-cols-3 max-w-7xl mx-auto" style={`transform: translateX(${offsetX});`}>
    {(includeSlugs ? selectedOffers : offers.slice(0, 6)).map((post) => (
      <div class="group relative bg-cover bg-center aspect-square grid items-end text-white overflow-hidden">
        <div class="absolute z-10 w-full h-full top-0 bg-gradient-to-br from-transparent to-gray-900 opacity-60"></div>
        <img class="absolute z-0 w-full h-full top-0 object-cover group-hover:scale-[1.02] transition duration-300 ease-in-out" src={post.frontmatter.imagefront} alt="" />
        <h3 class="text-3xl md:text-5xl z-20 relative text-center">{post.frontmatter.title}</h3>
        <div>
          <p class="text-white relative z-10 p-4 text-center" set:html={post.frontmatter.description}></p>
          <div class="flex flex-wrap p-4 gap-4 justify-center md:justify-between">
            <a href={post.url} class="relative text-sm z-10 bg-black/90 font-semibold uppercase py-3 px-6 text-white hover:bg-black/60">{moreLabel}</a>
            <a href={post.url} class="relative text-sm z-10 bg-white/90 font-semibold uppercase py-3 px-6 text-black hover:bg-white/60">{bookLabel}</a>
          </div>
        </div>
      </div>
    ))}
    </div>
  </div>
  
</section>
