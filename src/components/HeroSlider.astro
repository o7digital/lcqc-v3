---
const heroImage = {
  url: '/images/slider/casa-sunset-1920.jpg',
  focalPoint: { x: 0.5, y: 0.4 },
  description: 'La Casa Que Canta',
};
const fpParams = (fp) =>
  fp && typeof fp.x === 'number' && typeof fp.y === 'number'
    ? `&fp-x=${fp.x}&fp-y=${fp.y}`
    : '';
---

<!-- Hero Desktop (static) -->
<div class="hidden md:block absolute top-0 left-0 w-full h-full overflow-hidden">
  <picture>
    <source
      type="image/webp"
      srcset="/images/slider/casa-sunset-640.webp 640w, /images/slider/casa-sunset-1280.webp 1280w, /images/slider/casa-sunset-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src={heroImage.url}
      srcset="/images/slider/casa-sunset-640.jpg 640w, /images/slider/casa-sunset-1280.jpg 1280w, /images/slider/casa-sunset-1920.jpg 1920w"
      sizes="100vw"
      class="w-full h-full object-cover"
      style="object-position: center 40%;"
      alt={heroImage.description}
      loading="eager"
      decoding="async"
    />
  </picture>
</div>

<!-- Hero Mobile (static + focal crop) -->
<div class="md:!hidden absolute h-full w-full top-0 overflow-hidden">
  <picture>
    <source
      type="image/webp"
      srcset="/images/slider/casa-sunset-640.webp 640w, /images/slider/casa-sunset-1280.webp 1280w, /images/slider/casa-sunset-1920.webp 1920w"
      sizes="100vw"
    />
    <img
      src={heroImage.url}
      srcset="/images/slider/casa-sunset-640.jpg 640w, /images/slider/casa-sunset-1280.jpg 1280w, /images/slider/casa-sunset-1920.jpg 1920w"
      sizes="100vw"
      class="w-full h-full object-cover"
      style="object-position: center 40%;"
      alt={heroImage.description}
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/35 via-black/10 to-transparent pointer-events-none"></div>
</div>
