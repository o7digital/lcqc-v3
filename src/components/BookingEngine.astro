---
const chainId = "22402";
const hotelId = "78821";
---

<div class="reservation-box mx-auto shadow-md overflow-hidden group" tabindex="0" style="outline:none;">
  <div class="p-7 transition-all duration-300 opacity-0 pointer-events-none scale-95 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:scale-100 group-focus-within:opacity-100 group-focus-within:pointer-events-auto group-focus-within:scale-100" id="booking-form-container">
    <form id="booking-form" class="flex flex-wrap items-center gap-4">
      <!-- Arrival Date -->
      <div class="w-full sm:w-auto">
        <label for="arrival-date" class="block text-sm font-medium text-white">Arrival Date</label>
        <input 
          type="date" 
          id="arrival-date" 
          name="arrival-date" 
          required 
          class="mt-1 block w-full border-b border-white bg-transparent text-white focus:ring focus:ring-indigo-200 focus:ring-opacity-50" 
        />
      </div>

      <!-- Departure Date (auto: +1 night by default, editable) -->
      <div class="w-full sm:w-auto">
        <label for="departure-date" class="block text-sm font-medium text-white">Departure Date</label>
        <input 
          type="date" 
          id="departure-date" 
          name="departure-date" 
          required 
          class="mt-1 block w-full border-b border-white bg-transparent text-white focus:ring focus:ring-indigo-200 focus:ring-opacity-50" 
        />
      </div>

      <!-- Number of Adults (limited 1–2) -->
      <div class="w-full sm:w-auto">
        <label for="num-adults" class="block text-sm font-medium text-white">Number of Adults</label>
        <input 
          type="number" 
          id="num-adults" 
          name="num-adults" 
          min="1" 
          max="2"
          value="1" 
          required 
          class="mt-1 block w-full border-b border-white bg-transparent text-white focus:ring focus:ring-indigo-200 focus:ring-opacity-50" 
        />
      </div>

      <!-- Submit Button -->
      <div class="w-full sm:w-auto">
        <button 
          type="submit" 
          class="text-black/90 px-6 py-3 font-bold block text-base hover:border-l hover:border-white/90 uppercase bg-white"
        >
          {Astro.url.pathname.startsWith('/es') ? 'Consultar Disponibilidad' : 'Check Availability'}
        </button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ chainId, hotelId }}>
  function clampAdults(n) { return Math.min(2, Math.max(1, Number(n) || 1)); }

  function addDays(dateStr, days) {
    const d = new Date(dateStr);
    if (isNaN(d)) return '';
    d.setDate(d.getDate() + days);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd}`;
  }

  function clampToMin(value, min) {
    if (!value) return min;
    const v = new Date(value).getTime();
    const m = new Date(min).getTime();
    return isNaN(v) || v < m ? min : value;
  }

  function todayStr() {
    const d = new Date();
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd}`;
  }

  function buildBookingUrl() {
    const arrivalDate = document.getElementById('arrival-date').value;
    let departureDate = document.getElementById('departure-date').value;
    const numAdults = clampAdults(document.getElementById('num-adults').value);

    const baseUrl = "https://be.synxis.com/";
    let url = `${baseUrl}?Chain=${chainId}&Hotel=${hotelId}`;
    if (arrivalDate) url += `&arrive=${arrivalDate}`;
    // Fallback: if no departure chosen, default to arrival + 1 night
    if (!departureDate && arrivalDate) {
      const dflt = addDays(arrivalDate, 1);
      if (dflt) departureDate = dflt;
    }
    if (departureDate) url += `&depart=${departureDate}`;
    url += `&adult=${numAdults}`;
    url += `&rooms=1`; // Assuming 1 room for simplicity

    window.location.href = url;
  }

  document.getElementById('booking-form').addEventListener('submit', function(event) {
    event.preventDefault();
    buildBookingUrl();
  });

  // Automatically set departure to arrival + 1 night
  (function(){
    const arrival = document.getElementById('arrival-date');
    const depart = document.getElementById('departure-date');
    const adults = document.getElementById('num-adults');
    if (!arrival || !depart || !adults) return;

    const clampAndSync = () => {
      // Clamp adults between 1 and 2
      adults.value = String(clampAdults(adults.value));
      // Prevent past arrivals
      const today = todayStr();
      arrival.min = today;
      if (arrival.value) {
        arrival.value = clampToMin(arrival.value, today);
      }
      // If arrival is set, auto set departure = arrival + 1 day
      if (arrival.value) {
        const next = addDays(arrival.value, 1);
        if (next) {
          // Ensure minimum stay of 1 night
          depart.min = next;
          // Default departure to arrival + 1 night when arrival is chosen/changed
          depart.value = next;
        }
      } else {
        // Without arrival, at least prevent past departures: min = today + 1
        const minDep = addDays(today, 1);
        if (minDep) {
          depart.min = minDep;
          depart.value = clampToMin(depart.value, minDep);
        }
      }
    };

    // Initialize on load
    clampAndSync();
    arrival.addEventListener('change', clampAndSync);
    // Some browsers/devices fire input instead of change for date pickers
    arrival.addEventListener('input', clampAndSync);
    adults.addEventListener('change', clampAndSync);
    adults.addEventListener('input', clampAndSync);
    // When departure changes manually, enforce min constraint
    depart.addEventListener('change', () => {
      if (arrival.value) {
        const min = addDays(arrival.value, 1);
        if (min) depart.value = clampToMin(depart.value, min);
      }
    });
  })();

</script>
<script>
// Pour le support tactile/mobile : afficher le formulaire au toucher
if (typeof window !== 'undefined') {
  const box = document.querySelector('.reservation-box');
  const formContainer = document.getElementById('booking-form-container');
  if (box && formContainer) {
    let hideTimeout;
    box.addEventListener('touchstart', () => {
      formContainer.style.opacity = '1';
      formContainer.style.pointerEvents = 'auto';
      formContainer.style.transform = 'scale(1)';
      clearTimeout(hideTimeout);
      // Masquer après 2s si pas d'interaction
      hideTimeout = setTimeout(() => {
        formContainer.style.opacity = '0';
        formContainer.style.pointerEvents = 'none';
        formContainer.style.transform = 'scale(0.95)';
      }, 2000);
    });
  }
}
</script>

<style is:global>
.reservation-box .p-7 {
  transition: opacity 0.3s, transform 0.3s;
}
</style>
